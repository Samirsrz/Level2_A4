
enum Role{
    TENANT
    LANDLORD
    ADMIN

}

enum UserStatus{
    ACTIVE
    BANNED
}


model User{
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  googleId  String?    @unique
  role       Role 
  status     UserStatus    @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime    @updatedAt
 
  properties     Property[]      
  rentalRequests RentalRequest[] 

  @@map("users")

}